  <div class="wrap foot-row">
    <span>Radical Sabbatical · Endicott College · Beverly, MA</span>
    <span>Five days · Summer 2027</span>
  </div>
</footer>

<script>
(function(){
  var KEY = "radical-sabbatical-packing";
  var list = document.getElementById("packlist");
  if(!list) return;
  var boxes = list.querySelectorAll('input[type="checkbox"]');
  var saved = {};
  try{ saved = JSON.parse(localStorage.getItem(KEY) || "{}") || {}; }catch(e){ saved = {}; }
  boxes.forEach(function(b){ if(saved[b.id]) b.checked = true; });
  function save(){
    var out = {};
    boxes.forEach(function(b){ if(b.checked) out[b.id] = 1; });
    try{ localStorage.setItem(KEY, JSON.stringify(out)); }catch(e){}
  }
  list.addEventListener("change", function(e){ if(e.target && e.target.type === "checkbox") save(); });
})();
</script>
